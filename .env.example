# Cloudflare R2 S3 credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dj-booth
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Use an absolute path on a persistent disk in production.
SQLITE_PATH=./data/dj-booth.sqlite

# Optional. The bundled ffmpeg-static binary is used when omitted.
FFMPEG_PATH=

# Cleanup retention. Rooms are deleted this long after they stop being live,
# and previews no track points at are deleted this long after upload.
CLEANUP_ROOM_RETENTION_HOURS=24
CLEANUP_UPLOAD_GRACE_HOURS=24

# Dead-man switch. Create a check at healthchecks.io (or a self-hosted
# Healthchecks, Cronitor, Better Stack) and paste its ping URL here; the
# scheduled job then checks in on every run and the service alerts you when a
# check-in fails to arrive. Empty means no network traffic at all.
# Treat this URL as a secret: anyone holding it can forge check-ins.
CLEANUP_MONITOR_URL=

# Set to 1 to attach failure output to the /fail check-in. Off by default
# because stack traces can carry absolute paths, which would send your
# username and directory layout to a third party.
CLEANUP_MONITOR_SEND_OUTPUT=0
