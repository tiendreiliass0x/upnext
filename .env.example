# Cloudflare R2 S3 credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dj-booth
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Use an absolute path on a persistent disk in production.
SQLITE_PATH=./data/dj-booth.sqlite

# The address guests will actually use to reach this app, e.g.
# https://upnext.example.com or a tunnel hostname. Guest links and the QR code
# are built from it. Leave empty and they fall back to whatever address the DJ
# opened the booth on, which is usually a LAN IP that only works on the venue's
# wifi, or localhost, which resolves to the guest's own phone. The live room
# warns when that happens.
APP_PUBLIC_URL=

# Unlocks /admin, where song libraries are created and curated. Deliberately
# separate from the phone login, which is unverified: hanging the catalogue off
# a phone account would make the most privileged surface the easiest to take
# over. Leave empty and the admin area does not exist at all.
ADMIN_TOKEN=

# Deployment only. The hostname Caddy terminates TLS for. Without a domain you
# can use sslip.io, which resolves any 203-0-113-4.sslip.io style name to that
# IP. Usually the same host as APP_PUBLIC_URL.
SITE_ADDRESS=

# Optional. The bundled ffmpeg-static binary is used when omitted.
FFMPEG_PATH=

# Cleanup retention. Rooms are deleted this long after they stop being live,
# and previews no track points at are deleted this long after upload.
CLEANUP_ROOM_RETENTION_HOURS=24
CLEANUP_UPLOAD_GRACE_HOURS=24

# Dead-man switch. Create a check at healthchecks.io (or a self-hosted
# Healthchecks, Cronitor, Better Stack) and paste its ping URL here; the
# scheduled job then checks in on every run and the service alerts you when a
# check-in fails to arrive. Empty means no network traffic at all.
# Treat this URL as a secret: anyone holding it can forge check-ins.
CLEANUP_MONITOR_URL=

# Set to 1 to attach failure output to the /fail check-in. Off by default
# because stack traces can carry absolute paths, which would send your
# username and directory layout to a third party.
CLEANUP_MONITOR_SEND_OUTPUT=0
