{$SITE_ADDRESS} {
	encode zstd gzip

	# Songs are stored as uploaded; the API allows 60 MB plus a little slack
	# and rejects more itself. Bounding it here too keeps a hostile body from
	# ever reaching Node. Keep this above maximumUploadSize in
	# src/app/api/uploads/route.ts or production 413s before the app can.
	request_body {
		max_size 65MB
	}

	reverse_proxy app:3000 {
		# A 60 MB upload on venue wifi can legitimately take minutes, far
		# longer than a proxy would otherwise wait on one request.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
